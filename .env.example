# Copy to .env next to docker-compose.yml. Variable names follow nuxt.config.ts (runtimeConfig).

# --- Required ---------------------------------------------------------------

# Issuer of the identity provider: an https URL, exactly as its discovery document writes it
# (`<issuer>/.well-known/openid-configuration`, a trailing slash included). Kanidm has one issuer
# per client and it ends with the app's own client id (docs/kanidm-setup.md section 2); Keycloak is
# https://keycloak.example.org/realms/<realm>. Other providers: docs/oidc-providers.md.
NUXT_OIDC_ISSUER=https://idm.example.org/oauth2/openid/web-calendar

# Key for hashing app tokens, at least 32 characters; the container does not start without it.
# Generate one with: openssl rand -base64 48
NUXT_TOKEN_HASH_KEY=

# --- Optional ---------------------------------------------------------------

# Rotate the app-token hash key without logging any client out: more keys as `version:key` entries
# separated by commas, the CURRENT key first, for example NUXT_TOKEN_HASH_KEYS=2:<new key>. The key
# above stays valid as version 1 (list it as `1:<key>` only to put it first again). Tokens made with
# an older key keep working and move to the current one when they are used; remove an old key when
# no unexpired token uses it any more. A key may contain ':' but not ','. Steps:
# server/utils/auth/token-keys.ts. Empty means only the key above.
# NUXT_TOKEN_HASH_KEYS=

# Radicale's group file. The app writes it from its own groups (the ones imported from the sign-in
# claim, and the group of everyone who signed in lately); Radicale reads it. Default:
# /groups/htgroup in the container, .data/htgroup in development.
# NUXT_GROUPS_FILE=

# The app's own client id. Change it only if the client has another name; with Kanidm the issuer
# above must end with it.
# NUXT_OIDC_CLIENT_ID=web-calendar

# Further clients whose tokens the CalDAV gateway accepts, comma-separated. Empty means only the
# client above. With Kanidm each client has its own issuer (the one above with the client id
# replaced); with any other provider all of them share the issuer above.
# NUXT_OIDC_ALLOWED_CLIENTS=

# Scopes the browser asks for. `groups` is for the group claim; Entra needs the scope of your API
# here instead (api://<client-id>/caldav).
# NUXT_OIDC_SCOPE=openid profile email groups caldav

# The scope every access token must carry, in `scope` or `scp`. It is also what keeps ID tokens out,
# which have none. Cognito: <resource-server-id>/caldav.
# NUXT_OIDC_REQUIRED_SCOPE=caldav

# Further `aud` values that make an access token ours, comma-separated: the API identifier of Auth0
# or Entra, whose tokens are issued for the API and not for the client. Empty for the others.
# NUXT_OIDC_AUDIENCE=

# Host names besides the issuer's own that the provider's signing keys may be fetched from,
# comma-separated, exact names. By default the `jwks_uri` of the discovery document must be on the
# issuer's host, so that nobody who can change the document can send the server to other keys. Some
# providers keep their keys elsewhere (Entra v1: login.microsoftonline.com; Google:
# www.googleapis.com). Name one only if you trust it as much as the provider.
# NUXT_OIDC_JWKS_HOSTS=

# Origins of external browser apps that may call /caldav/, comma-separated. Empty means none.
# NUXT_GATEWAY_CORS_ORIGINS=

# Largest request body the CalDAV gateway forwards, in bytes (one event per request). Keep it equal
# to max_content_length in deploy/radicale/config, and restart Radicale after changing that file.
# NUXT_GATEWAY_MAX_BODY_BYTES=10485760

# Requests one signed-in user may have in flight at the same time (from the request until its answer
# has been read). The next ones get 429 with Retry-After: 1. A calendar app syncs a few at a time;
# raise it only if a client of yours legitimately opens more.
# NUXT_GATEWAY_MAX_CONCURRENT_PER_USER=8

# Takes the client address of the failed-login throttle from the last entry of X-Forwarded-For
# instead of the socket's. Set it to true ONLY behind a reverse proxy that is the only way to reach
# the app and that appends the client's address to X-Forwarded-For; otherwise a client can name any
# address and escape the throttle. With false, every client behind a proxy shares the proxy's address
# and one attacker can lock all of them out of Basic login. Exactly true or false.
# NUXT_GATEWAY_TRUST_FORWARDED_FOR=false

# Group whose members are admins, as the provider writes it in the groups claim: a name, an SPN
# (name@domain), an id or a path. Admin routes ask the provider on every request. Must not be empty.
# NUXT_OIDC_ADMIN_GROUP=calendar_admins

# The claim that lists a person's groups, in userinfo and in the access token. Looked up as written,
# so `cognito:groups`, a URL or a URN works. Groups are imported from it at sign-in; an admin picks
# which ones on the Groups page.
# NUXT_OIDC_GROUPS_CLAIM=groups

# Groups that are never offered for import: names or `prefix*`, comma-separated. The default hides
# Kanidm's built-in groups.
# NUXT_OIDC_GROUPS_IGNORE=idm_*,system_*,domain_*

# Seconds the cached signing keys are used before they are fetched again. A key the provider
# removed is trusted for at most this long. A whole number, at least 1.
# NUXT_OIDC_KEY_MAX_AGE_SEC=3600

# Days after a person's last sign-in in which their app tokens still work and they count as being in
# the group of everyone (web_calendar_users). A whole number from 1 to 365. Imported and app groups
# do not expire with it. Signing in to the web app, or a calendar app that signs in through the
# browser, renews it; using an app token does not.
# NUXT_SIGNIN_WINDOW_DAYS=30

# The iCal proxy (.ics subscriptions): seconds a fetched file is served without asking the source
# again (0 = always ask), the largest file in bytes, and the time allowed for one fetch.
# NUXT_ICAL_PROXY_CACHE_TTL_SEC=300
# NUXT_ICAL_PROXY_MAX_BYTES=5242880
# NUXT_ICAL_PROXY_TIMEOUT_MS=10000

# NUXT_ICAL_PROXY_ALLOW_PRIVATE=true switches the SSRF guard of the iCal proxy off, so subscriptions
# can reach internal addresses. It is for tests only; the server refuses to start with it when
# NODE_ENV=production (the container).
# NUXT_ICAL_PROXY_ALLOW_PRIVATE=false

# Hosts the server may contact for its users (iCal subscriptions and external CalDAV accounts),
# comma-separated and case-insensitive: exact host names (cal.example.org) and domains
# (*.example.org: every host below it, not example.org itself). Without a list a script that got
# into the page could make this server send data to any host; with one it can only reach the hosts
# named here. A listed host may sit in a private range (an internal server needs an entry), but
# loopback, link-local (169.254.x.x) and the CalDAV store's host never can. No schemes, ports, paths
# or a bare *; international names as xn--. The server does not start with a malformed list.
# In production (the container) an EMPTY list is refused too: set this, or knowingly allow every
# public host with NUXT_OUTBOUND_ALLOW_ANY_HOST=true below.
# NUXT_OUTBOUND_ALLOWED_HOSTS=

# true lets the server contact any public host its users name, when no list is set above (for
# example for public calendar feeds from many sites). Ignored when a list is set.
# NUXT_OUTBOUND_ALLOW_ANY_HOST=false

# Key that seals the passwords of external CalDAV accounts (the browser keeps the sealed text, the
# server keeps nothing): 32 random bytes as base64 or 64 hex characters. Generate one with:
# openssl rand -base64 32. Empty means accounts with a login are off (accounts without one still
# work). Changing the key voids every sealed password: users enter theirs again. The server does
# not start with a malformed key. Treat it like NUXT_TOKEN_HASH_KEY: with the key, a sealed
# password copied out of a browser can be read.
# NUXT_EXTERNAL_SEAL_KEY=

# Sharing writer: turns the access rules into Radicale shares. Seconds between reconciles (at most
# 900; 300 by default), hours between the nightly consistency audits (1 to 168; 24 by default), and
# service principals whose calendars appear as shared calendars (comma-separated, each starting with
# _, for example _team).
# NUXT_SHARING_RECONCILE_INTERVAL_SEC=300
# NUXT_SHARING_AUDIT_INTERVAL_HOURS=24
# NUXT_SHARING_SHARED_OWNERS=

# Resources: seconds between the checks of the events of bookings for moved or deleted events (at
# most 900; 300 by default), and whether a manager may cancel the bookings of others (true by
# default; false lets only the requester cancel). Exactly true or false.
# NUXT_RESOURCES_RECONCILE_INTERVAL_SEC=300
# NUXT_RESOURCES_MANAGER_CANCEL=true

# Demo mode: the SPA skips the login and shows mock data. For previews and browser tests only; never
# in a real deployment (the server logs a warning when it is on). Exactly true or false.
# NUXT_DEMO=false

# Organization time zone.
# TZ=Europe/Berlin
