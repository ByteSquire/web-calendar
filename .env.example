# Copy to .env next to docker-compose.yml. Variable names follow nuxt.config.ts (runtimeConfig).

# --- Required ---------------------------------------------------------------

# Issuer of the app's own Kanidm client. It must be an https URL that ends with the client id
# (docs/kanidm-setup.md section 2).
NUXT_OIDC_ISSUER=https://idm.example.org/oauth2/openid/web-calendar

# Key for hashing app tokens, at least 32 characters; the container does not start without it.
# Generate one with: openssl rand -base64 48
NUXT_TOKEN_HASH_KEY=

# --- Optional ---------------------------------------------------------------

# Rotate the app-token hash key without logging any client out: more keys as `version:key` entries
# separated by commas, the CURRENT key first, for example NUXT_TOKEN_HASH_KEYS=2:<new key>. The key
# above stays valid as version 1 (list it as `1:<key>` only to put it first again). Tokens made with
# an older key keep working and move to the current one when they are used; remove an old key when
# no unexpired token uses it any more. A key may contain ':' but not ','. Steps:
# server/utils/auth/token-keys.ts. Empty means only the key above.
# NUXT_TOKEN_HASH_KEYS=

# Read-only Kanidm API token of the group-sync service account (docs/kanidm-setup.md section 3).
# Without it the container starts, but Radicale's group file is never filled.
# NUXT_GROUP_SYNC_TOKEN=

# Seconds between group-sync runs. A removed group member keeps access for up to this long, so
# 300 is the ceiling: larger values are refused at start.
# NUXT_GROUP_SYNC_INTERVAL_SEC=60

# Radicale's group file. Default: /groups/htgroup in the container, .data/htgroup in development.
# NUXT_GROUP_SYNC_FILE=

# The app's own client id. Change it only if the Kanidm client has another name; the issuer above
# must end with it.
# NUXT_OIDC_CLIENT_ID=web-calendar

# Further Kanidm clients whose tokens the CalDAV gateway accepts, comma-separated. Empty means only
# the client above.
# NUXT_OIDC_ALLOWED_CLIENTS=

# Origins of external browser apps that may call /caldav/, comma-separated. Empty means none.
# NUXT_GATEWAY_CORS_ORIGINS=

# Largest request body the CalDAV gateway forwards, in bytes.
# NUXT_GATEWAY_MAX_BODY_BYTES=10485760

# Takes the client address of the failed-login throttle from the last entry of X-Forwarded-For
# instead of the socket's. Set it to true ONLY behind a reverse proxy that is the only way to reach
# the app and that appends the client's address to X-Forwarded-For; otherwise a client can name any
# address and escape the throttle. With false, every client behind a proxy shares the proxy's address
# and one attacker can lock all of them out of Basic login. Exactly true or false.
# NUXT_GATEWAY_TRUST_FORWARDED_FOR=false

# Kanidm group whose members are admins. Admin routes (Phase 3) ask Kanidm on every request; the
# short name and the SPN (name@domain) both match. Must not be empty.
# NUXT_OIDC_ADMIN_GROUP=calendar_admins

# Seconds the cached Kanidm signing keys are used before they are fetched again. A key Kanidm
# removed is trusted for at most this long. A whole number, at least 1.
# NUXT_OIDC_KEY_MAX_AGE_SEC=3600

# The iCal proxy (.ics subscriptions): seconds a fetched file is served without asking the source
# again (0 = always ask), the largest file in bytes, and the time allowed for one fetch.
# NUXT_ICAL_PROXY_CACHE_TTL_SEC=300
# NUXT_ICAL_PROXY_MAX_BYTES=5242880
# NUXT_ICAL_PROXY_TIMEOUT_MS=10000

# NUXT_ICAL_PROXY_ALLOW_PRIVATE=true switches the SSRF guard of the iCal proxy off, so subscriptions
# can reach internal addresses. It is for tests only; the server refuses to start with it when
# NODE_ENV=production (the container).
# NUXT_ICAL_PROXY_ALLOW_PRIVATE=false

# Hosts the server may contact for its users (iCal subscriptions and external CalDAV accounts),
# comma-separated and case-insensitive: exact host names (cal.example.org) and domains
# (*.example.org: every host below it, not example.org itself). Empty means every public host.
# Without a list a script that got into the page could make this server send data to any host; with
# one it can only reach the hosts named here. A listed host may sit in a private range (an internal
# server needs an entry), but loopback, link-local (169.254.x.x) and the CalDAV store's host never
# can. No schemes, ports, paths or a bare *; international names as xn--. The server does not start
# with a malformed list.
# NUXT_OUTBOUND_ALLOWED_HOSTS=

# Key that seals the passwords of external CalDAV accounts (the browser keeps the sealed text, the
# server keeps nothing): 32 random bytes as base64 or 64 hex characters. Generate one with:
# openssl rand -base64 32. Empty means accounts with a login are off (accounts without one still
# work). Changing the key voids every sealed password: users enter theirs again. The server does
# not start with a malformed key. Treat it like NUXT_TOKEN_HASH_KEY: with the key, a sealed
# password copied out of a browser can be read.
# NUXT_EXTERNAL_SEAL_KEY=

# Sharing writer: turns the access rules into Radicale shares. Seconds between reconciles (at most
# 900; 300 by default), hours between the nightly consistency audits (1 to 168; 24 by default), and
# service principals whose calendars appear as shared calendars (comma-separated, each starting with
# _, for example _team).
# NUXT_SHARING_RECONCILE_INTERVAL_SEC=300
# NUXT_SHARING_AUDIT_INTERVAL_HOURS=24
# NUXT_SHARING_SHARED_OWNERS=

# Demo mode: the SPA skips the login and shows mock data. For previews and browser tests only; never
# in a real deployment (the server logs a warning when it is on). Exactly true or false.
# NUXT_DEMO=false

# Organization time zone.
# TZ=Europe/Berlin
