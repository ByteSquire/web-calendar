# Static rights for the test stack (copied to .local/rules/rights by `spike.sh init`).
# Radicale loads this file once at startup, so it must not change per share. Sharing between users
# and groups goes through the [sharing] database instead (see radicale/config and design §8).
# The first matching section wins.

# Everyone may list the root.
[root]
user: .+
collection:
permissions: R

# Each user owns their own home and the calendars under it.
[principal]
user: .+
collection: {user}
permissions: RW

[calendars]
user: .+
collection: {user}/[^/]+
permissions: rw
