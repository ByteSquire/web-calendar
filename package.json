{
  "name": "web-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone, self-hosted web calendar that aggregates multiple calendars into one unified view.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run typecheck:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "typecheck:e2e": "tsc -p e2e",
    "test:e2e": "nuxt build && playwright test",
    "test": "vitest run",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "test:gateway:prod": "node scripts/test-gateway-prod.mjs",
    "audit:prod": "node scripts/audit-prod.mjs",
    "radicale:usage": "node scripts/radicale-usage.mjs"
  },
  "dependencies": {
    "@fullcalendar/vue3": "7.1.3",
    "@fullcalendar/vue3-scheduler": "7.1.3",
    "@iconify-json/lucide": "^1.2.150",
    "@nuxt/ui": "^4.12.0",
    "better-sqlite3": "^13.0.3",
    "ical.js": "^2.2.1",
    "jose": "^6.2.14",
    "nuxt": "^4.6.3",
    "oidc-client-ts": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.6",
    "tsdav": "^2.5.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
