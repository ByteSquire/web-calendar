{
  "name": "web-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone, self-hosted web calendar that aggregates multiple calendars into one unified view.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check": "npm run fmt:check && npm run lint && npm run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@fullcalendar/vue3": "^7.1.3",
    "nuxt": "^4.6.2",
    "temporal-polyfill": "^1.0.6",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.0"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
