# Keep the build context small and avoid leaking host state into the image.

# Version control
.git
.gitignore

# Dependencies, caches and local build output
node_modules
.npm-cache
.nuxt
.output
.data

# Local environment / secrets
.env
.env.*

# Logs
*.log
npm-debug.log*

# Repository metadata, docs and deployment files (not needed to build the app)
docs
dev
deploy
README.md
docker-compose*.yml

# Dev container and CI configuration
.devcontainer
.github

# Test/build caches and the browser tests
coverage
e2e
playwright.config.ts
playwright-report
test-results
blob-report
*.tsbuildinfo

# Local npm configuration (may contain registry tokens)
.npmrc
