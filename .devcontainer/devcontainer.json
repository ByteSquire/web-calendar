{
  "name": "Web Calendar",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",
  "containerUser": "node",
  "workspaceFolder": "/workspaces/web-calendar",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/web-calendar,type=bind",
  "mounts": [
    "source=web-calendar-node-modules-${devcontainerId},target=/workspaces/web-calendar/node_modules,type=volume"
  ],
  "postCreateCommand": "sudo chown -R node:node node_modules && npm ci",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Web Calendar (Nuxt)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Vue.volar", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
